# Excel report path.
STORE_PARSER_OUTPUT=output/stores.xlsx

# Optional explicit snapshot path. If empty or missing, it is derived from the Excel filename.
STORE_PARSER_SNAPSHOT=output/stores_snapshot.json

# Log file path and log level.
STORE_PARSER_LOG_FILE=logs/parser.log
STORE_PARSER_LOG_LEVEL=INFO

# HTTP client settings.
STORE_PARSER_TIMEOUT=20
STORE_PARSER_RETRIES=3

# Optional source URL overrides. Keep official URLs unless you intentionally point to another official mirror/stage.
STORE_PARSER_KB_BASE_URL=https://krasnoeibeloe.ru
STORE_PARSER_MONETKA_BASE_URL=https://www.monetka.ru
STORE_PARSER_MARIA_RA_BASE_URL=https://www.maria-ra.ru
STORE_PARSER_MARIA_RA_MAP_URL=https://www.maria-ra.ru/o-kompanii/karta-seti/
